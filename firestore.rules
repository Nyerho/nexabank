rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isBootstrapAdmin() {
      return signedIn() && request.auth.token.email == 'admin@nexabank.com';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).changedKeys();
    }

    match /admins/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if (isBootstrapAdmin() && isSelf(uid)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) || isAdmin();
      allow update: if isAdmin()
        || (isSelf(uid)
          && changedKeys().hasOnly([
            'name',
            'email',
            'phone',
            'dob',
            'address',
            'city',
            'state',
            'zip',
            'country',
            'photo'
          ]));
      allow delete: if isAdmin();
    }

    match /accounts/{accountId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /transactions/{txnId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.userIds);
      allow create: if isAdmin() || (signedIn() && request.auth.uid in request.resource.data.userIds);
      allow update, delete: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /loans/{loanId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /payees/{payeeId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /auditLog/{entryId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /login_otps/{userId} {
      allow read, create, update, delete: if isSelf(userId);
    }

    match /mail/{id} {
      allow create: if signedIn()
        && (
          isAdmin()
          || (request.resource.data.to is string && request.resource.data.to == request.auth.token.email)
        );
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
